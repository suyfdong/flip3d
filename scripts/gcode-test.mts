// G-code parser tests. Run: npx tsx scripts/gcode-test.mts
import { parseGcode, arcPoints } from "@/lib/gcode/parser";

let pass = 0, fail = 0;
function check(name: string, cond: boolean, extra = "") {
  if (cond) { pass++; console.log(`  ✓ ${name} ${extra}`); } else { fail++; console.log(`  ✗ FAIL: ${name} ${extra}`); }
}
const near = (a: number, b: number, e = 1e-6) => Math.abs(a - b) < e;

console.log("arcPoints");
{
  // CCW quarter circle radius 10 from (10,0) to (0,10), centre (0,0).
  const p = arcPoints(10, 0, 0, 10, -10, 0, null, false);
  check("ends exactly on target", p[p.length - 1][0] === 0 && p[p.length - 1][1] === 10);
  check("all points on radius 10", p.every(([x, y]) => near(Math.hypot(x, y), 10, 1e-9)));
  check("goes through the first quadrant (CCW)", p.every(([x, y]) => x >= -1e-9 && y >= -1e-9));
  const cw = arcPoints(10, 0, 0, 10, -10, 0, null, true);
  check("G2 same endpoints goes the long way (through x<0 or y<0)", cw.some(([x, y]) => x < -1 || y < -1), `(${cw.length} pts)`);
  const r = arcPoints(10, 0, 0, 10, 0, 0, 10, false);
  check("R form = I/J form for the short arc", r.every(([x, y]) => near(Math.hypot(x, y), 10, 1e-6)) && r.every(([x, y]) => x >= -1e-6 && y >= -1e-6));
  const rLong = arcPoints(10, 0, 0, 10, 0, 0, -10, false);
  const arcLen = (pts: Array<[number, number]>, sx: number, sy: number) => pts.reduce((s, q, k) => { const prev = k ? pts[k - 1] : [sx, sy]; return s + Math.hypot(q[0] - prev[0], q[1] - prev[1]); }, 0);
  check("negative R takes the long way (270° = 47.1 mm)", near(arcLen(rLong, 10, 0), 1.5 * Math.PI * 10, 0.05), `(${arcLen(rLong, 10, 0).toFixed(2)})`);
  check("positive R short way (90° = 15.7 mm)", near(arcLen(r, 10, 0), 0.5 * Math.PI * 10, 0.05));
  const full = arcPoints(10, 0, 10, 0, -10, 0, null, false);
  const len = full.reduce((s, q, k) => { const prev = k ? full[k - 1] : [10, 0]; return s + Math.hypot(q[0] - prev[0], q[1] - prev[1]); }, 0);
  check("full circle when start == end", near(len, 2 * Math.PI * 10, 0.05), `(${len.toFixed(3)})`);
}

console.log("parseGcode");
{
  const g = [
    "; generated by OrcaSlicer",
    "G90", "M83",
    "G1 X10 Y0 Z0.2 F3000",
    "G3 X0 Y10 I-10 J0 E1.5",   // quarter arc with extrusion
    "G1 X0 Y20 E0.5",
    "G2X10Y30I10J0E0.8",         // no spaces, CW arc
    "G01 X20 Y30 E0.2",          // zero-padded command
  ].join("\n");
  const parsed = parseGcode(g);
  const last = parsed.moves[parsed.moves.length - 1];
  check("ends at X20 Y30", near(last.x, 20) && near(last.y, 30));
  const arc = parsed.moves.filter((m) => m.lineIndex === 4);
  check("arc expanded into many segments", arc.length > 20, `(${arc.length})`);
  const arcE = arc.reduce((s, m) => s + m.de, 0);
  check("arc extrusion sums to E1.5", near(arcE, 1.5, 1e-9));
  check("first G1 after arc starts where the arc ended", near(parsed.moves.find((m) => m.lineIndex === 5)!.px, 0) && near(parsed.moves.find((m) => m.lineIndex === 5)!.py, 10));
  check("no-space G2 parsed", parsed.moves.some((m) => m.lineIndex === 6));
  check("G01 parsed", parsed.moves.some((m) => m.lineIndex === 7));
  check("slicer detected", parsed.detectedSlicer === "OrcaSlicer");
  check("bbox covers the arc (x reaches 10)", near(parsed.bbox.max[0], 20) && parsed.bbox.min[0] <= 1e-6);
}

console.log(`\n${pass} passed, ${fail} failed`);
process.exit(fail ? 1 : 0);
